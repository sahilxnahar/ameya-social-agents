{
  "name": "ameya-social-agents",
  "version": "0.3.0",
  "description": "The Claude Code agent team that drafts Ameya Heights' social media and never posts without the owner's approval.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "queue": "node scripts/queue.mjs",
    "approve": "node scripts/queue.mjs approve",
    "reject": "node scripts/queue.mjs reject",
    "review": "node scripts/review.mjs",
    "publish": "node scripts/publish.mjs",
    "inbox": "node scripts/inbox.mjs",
    "insights": "node scripts/insights.mjs",
    "youtube-auth": "node scripts/auth/youtube-token.mjs",
    "schedule:install": "sh scripts/schedule/install.sh",
    "schedule:uninstall": "sh scripts/schedule/uninstall.sh",
    "test": "node --test tests/"
  },
  "optionalDependencies": {
    "@vercel/blob": "^1.0.0"
  }
}
