# Copy to .env (git-ignored) and fill in only what you use. Channels without credentials fall back
# to a hand-off pack in outbox/. Scripts read this file themselves; nothing goes in your shell.

# Meta Graph API version used for Facebook, Instagram and WhatsApp calls.
META_GRAPH_VERSION=v23.0
# Facebook Page id.
META_PAGE_ID=
# Long-lived Page access token (also used for Instagram).
META_PAGE_TOKEN=
# Instagram professional account id linked to the Page.
IG_USER_ID=
# Instagram handle without @, used to skip our own comments in the inbox.
IG_USERNAME=

# WhatsApp Cloud API phone number id.
WA_PHONE_NUMBER_ID=
# WhatsApp Cloud API access token.
WA_TOKEN=

# Vercel Blob token, to upload local images to a public URL at publish time.
BLOB_READ_WRITE_TOKEN=

# Ameya CRM base URL (the /api/v1 routes are added by the scripts).
CRM_API_URL=
# Read-only CRM token, used by `npm run inbox` to pick up new leads.
CRM_READ_TOKEN=
# Write CRM token, used only by the publisher to record a lead after an approved send.
CRM_WRITE_TOKEN=

# Google OAuth client id for YouTube uploads.
YT_CLIENT_ID=
# Google OAuth client secret for YouTube uploads.
YT_CLIENT_SECRET=
# YouTube refresh token, printed by `npm run youtube-auth`.
YT_REFRESH_TOKEN=
